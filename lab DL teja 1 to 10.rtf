\b Code\b0 :\par
import numpy as np\par
import matplotlib.pyplot as plt\par
from sklearn.model_selection import train_test_split\par
from sklearn.preprocessing import PolynomialFeatures\par
from sklearn.linear_model import LinearRegression\par
from sklearn.metrics import mean_squared_error\par
\par
np.random.seed(42)\par
\par
X = np.linspace(0.5, 3, 150).reshape(-1, 1)\par
y = 50 + 80*X.ravel() + 30*X.ravel()**2 + np.random.normal(0, 20, 150)\par
\par
